{
  "name": "doculigent",
  "version": "1.3.1",
  "private": true,
  "description": "Open-source, local-first screen recorder + AI video workspace.",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Baraklabs",
    "email": "info@baraklabs.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:mac-native": "node scripts/build-mac-screencapturekit-helper.mjs",
    "build:windows-native": "node scripts/build-windows-capture-helper.mjs",
    "build:linux-native": "node scripts/build-linux-capture-helper.mjs",
    "build": "npm run build:mac-native && npm run build:windows-native && npm run build:linux-native && electron-vite build && electron-builder",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/lib-storage": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.55.4",
    "ffmpeg-static": "^5.2.0",
    "keytar": "^7.9.0",
    "koffi": "^3.1.1",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  }
}
